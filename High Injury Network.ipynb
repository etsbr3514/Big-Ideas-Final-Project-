    "# High Injury Network Dataset"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "32b6e927-b37b-4549-bf89-131220d226ff",
   "metadata": {},
   "source": [
    "Comparing the number of traffic injuries in each neighborhood"
    "This project analyzes different road metrics in order to determine which neighborhood in Pittsburgh has the safest roads."
    "The metric we are using to determine the best neighborhood is road and traffic safety. I am counting the amount of traffic violations in each neighborhood using Traffic Count Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "019bda03-5f89-49fe-a71e-665d1fb465d7",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x600 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "trafficCount = \"https://data.wprdc.org/datastore/dump/6dfd4f8f-cbf5-4917-a5eb-fd07f4403167\"\n",
    "\n",
    "df = pd.read_csv(trafficCount)\n",
    "\n",
    "counts = df[\"neighborhood\"].value_counts().sort_index()\n",
    "\n",
    "ax = counts.plot(kind=\"bar\", figsize=(10, 6), color=\"steelblue\", edgecolor=\"black\")\n",
    "ax.set_title(\"Number of Records by Neighborhood\")\n",
    "ax.set_xlabel(\"Neighborhood\")\n",
    "ax.set_ylabel(\"Count\")\n",
    "\n",
    "for bar in ax.patches:\n",
    "    ax.text(bar.get_x() + bar.get_width() / 2, bar.get_height(),\n",
    "            int(bar.get_height()), ha=\"center\", va=\"bottom\")\n",
    "\n",
    "plt.xticks(rotation=45, ha=\"right\")\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"neighborhood_bar_graph.png\", dpi=150)\n",
    "plt.show()"
   ]
  },
